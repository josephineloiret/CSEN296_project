APP_ORIGIN=http://localhost:8000
APP_ENV=development
AI_PROVIDER=local
PUBLIC_GUEST_ENABLED=false
# GUEST_LIVE_MODEL=false  (true lets guests use the live model within GUEST_DAILY/MONTHLY_BUDGET_USD)
# Local mode uses deterministic agent behavior and lexical hash vectors.
# To enable actual LLM generation and learned embeddings, configure:
# AI_PROVIDER=openai
# OPENAI_API_KEY=your-private-api-key
# OPENAI_MODEL=gpt-5.6-luna
# EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_REASONING_EFFORT=none
# OPENAI_DAILY_BUDGET_USD=1.00
# OPENAI_MONTHLY_BUDGET_USD=5.00
# DATABASE_PATH=/absolute/path/to/refundguard.sqlite3

# Optional case-file import. Keep service account JSON in a private environment or deployment secret.
# DRIVE_CASE_FILES_FOLDER_ID=
# DRIVE_CASE_FILES_SERVICE_ACCOUNT_JSON=
