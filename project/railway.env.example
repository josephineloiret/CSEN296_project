# Copy these NONSECRET settings into the Railway service Variables screen.
# Set OPENAI_API_KEY separately as a secret there; never commit a real key.
APP_ENV=production
AI_PROVIDER=openai
OPENAI_MODEL=gpt-5.6-luna
OPENAI_REASONING_EFFORT=none
EMBEDDING_MODEL=text-embedding-3-small
OPENAI_DAILY_BUDGET_USD=1.00
OPENAI_MONTHLY_BUDGET_USD=5.00
DATABASE_PATH=/data/refundguard.sqlite3
# Set APP_ORIGIN to the exact generated HTTPS URL, or leave it unset to derive
# it from Railway's RAILWAY_PUBLIC_DOMAIN after enabling Public Networking.
# Attach a persistent volume mounted at /data. One replica, one worker.
