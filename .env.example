APP_ORIGIN=http://localhost:8000
APP_ENV=development
AI_PROVIDER=local
# Local mode uses deterministic agent behavior and lexical hash vectors.
# To enable actual LLM generation and learned embeddings, configure:
# AI_PROVIDER=openai
# OPENAI_API_KEY=your-private-api-key
# OPENAI_MODEL=gpt-5.6-luna
# EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_REASONING_EFFORT=none
# OPENAI_DAILY_BUDGET_USD=1.00
# OPENAI_MONTHLY_BUDGET_USD=5.00
# DATABASE_PATH=/absolute/path/to/refundguard.sqlite3
